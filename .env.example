# Firebase Service Account (JSON da chave privada convertido para base64)
FIREBASE_SERVICE_ACCOUNT=

# Bucket do Storage, onde ficam as fotos de perfil (opcional).
# Sem esta env, cai em `<project_id>.firebasestorage.app`. Projetos antigos
# usam `<project_id>.appspot.com` — confira no console se o upload falhar.
FIREBASE_STORAGE_BUCKET=

# Web API key do Firebase (Console > Project Settings > apiKey).
# Usada para autenticar login por email/senha via Identity Toolkit REST.
FIREBASE_WEB_API_KEY=

# Segredo do JWT do portal do aluno (login por PIN, sem Firebase).
# Ha um fallback de desenvolvimento, mas DEFINA em producao.
JWT_SECRET=

# Origens autorizadas no CORS, separadas por virgula.
# OBRIGATORIA EM PRODUCAO: o CORS usa credenciais (cookie de sessao) e
# `Allow-Origin: *` e incompativel com isso — sem esta env, NENHUMA origem passa
# e o app inteiro para. Em producao precisa listar os dois dominios do front.
# Ex.: https://tichr.com.br,https://www.tichr.com.br
# Default de dev (se vazia): http://localhost:4200
CORS_ORIGINS=http://localhost:4200

# URL publica do app (default https://tichr.com.br).
# E o `continueUrl` dos e-mails de confirmacao e redefinicao — traz o professor
# de volta ao app depois do clique. O dominio precisa estar nos authorized
# domains do projeto Firebase, senao o link e rejeitado.
APP_BASE_URL=http://localhost:4200

# Porta do servidor (opcional, default 3000)
PORT=3000

# NODE_ENV: normalmente definida pela plataforma (a Vercel manda `production`),
# nao aqui. Listada porque tem efeito visivel no auth: o cookie de sessao so
# recebe o atributo `Secure` quando vale `production` — em http://localhost o
# `Secure` impediria o cookie de ser gravado e o login local nao se manteria.
# NODE_ENV=development

# Chave da API do Gemini (geração por IA de dicas do Wor e perguntas do Qlick).
# Sem ela, a geração por IA fica indisponível (503) e o professor escreve manualmente.
GEMINI_API_KEY=

# Modelo do Gemini (opcional, default gemini-3.5-flash). Permite trocar o modelo
# sem alterar o código quando o Google atualiza/depreca versões.
GEMINI_MODEL=gemini-3.5-flash

# Chave da API da Resend — alerta por e-mail quando um professor manda feedback.
# NAO e obrigatoria: sem ela o feedback e salvo normalmente e a inbox do admin
# mostra "alerta nao enviado". O professor nunca perde o relato por causa disto.
RESEND_API_KEY=

# Remetente do alerta (opcional, default "Tichr <nao-responda@tichr.com.br>").
# O dominio precisa estar VERIFICADO na Resend — sem verificacao, a Resend so
# entrega para o e-mail do dono da conta e o alerta simplesmente nao chega.
RESEND_FROM=

# Nao ha env de destinatarios do alerta: quem recebe e todo professor com
# `professores/{uid}.isAdmin == true` (a mesma fonte que libera o backoffice).
# Promover alguem pelo painel ja passa a alertar, sem redeploy.
